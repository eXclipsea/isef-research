# ResearchOS runs fully local — NO API KEYS ARE REQUIRED.
# Search uses SearXNG (local) and free scholarly APIs (Semantic Scholar,
# arXiv, PubMed, CrossRef) that need no keys. This file is entirely optional.
#
# To use it: copy this file to ".env" and fill in anything you want.

# Your email — only used by the free Unpaywall API to find legal open-access
# PDFs. Optional, but recommended (it's not a key, just an email).
EMAIL=your_email@example.com

# OPTIONAL: a free Brave Search API key, used only as a fallback if SearXNG
# isn't running. Get one free at https://brave.com/search/api . Leave blank
# to rely on local SearXNG (the default).
BRAVE_API_KEY=
